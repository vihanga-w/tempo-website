# Local development. tempo-be.vihangaw.xyz now serves the VPS, so local work
# talks to the API on localhost directly.
#
# This lives in .env.development, NOT .env.local: next dev reads it, next build
# does not. .env.local is read by BOTH — it once sat there, silently overrode
# .env.production during `next build`, and shipped an iOS bundle whose every
# request went to a localhost nothing was listening on. The app hung on its
# loading screen with no error anywhere but the webview console.
NEXT_PUBLIC_API_URL=http://localhost:2246
